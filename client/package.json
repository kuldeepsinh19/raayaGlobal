{
  "name": "raaya-global-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev --listen 3000",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "smoke": "esbuild scripts/smoke-api.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=node_modules/.cache/smoke-api.cjs && node node_modules/.cache/smoke-api.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "axios": "^1.7.2",
    "framer-motion": "^11.2.11",
    "lucide-react": "^0.396.0",
    "nodemailer": "^6.9.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
